# /etc/yct/env  -  proprietaire root:root, permissions 600
# systemd lit ce fichier en tant que root puis bascule sur l'utilisateur yct.
# Les valeurs sont injectees comme variables d'environnement du processus,
# elles ne sont JAMAIS lisibles par le navigateur ni par l'utilisateur yct sur disque.

# La cible BoJ, sa date et son URL officielle sont un contrat public versionne
# dans config/boj-policy.json. Elles ne sont pas dupliquees dans ce fichier de
# secrets. Le service fixe BOJ_POLICY_PATH=/opt/yct/boj-policy.json.

# Optionnel : une cle active l'API FRED JSON. Sans cle, le builder utilise
# automatiquement l'export CSV officiel des series DFEDTARU et DFEDTARL.
#FRED_API_KEY=

# Optionnel : jeton applicatif Socrata pour des quotas CFTC plus larges
# (inutile a 4 requetes par jour). https://publicreporting.cftc.gov -> Sign up for an App Token
#SOCRATA_APP_TOKEN=

# Optionnel : ajoute une cotation USD/JPY Massive horodatee dans market.json.
# data.json conserve toujours la reference BCE canonique. La cle reste cote
# serveur et n'est jamais ecrite dans les journaux, le snapshot ou le navigateur.
#MASSIVE_API_KEY=

# Optionnel : surcharge du chemin de sortie (defaut /var/lib/yct/data.json)
#OUT_PATH=/var/lib/yct/data.json
#STATUS_PATH=/var/lib/yct/status.json
#CANDIDATE_PATH=/var/lib/yct/candidate.json
#MARKET_PATH=/var/lib/yct/market.json
