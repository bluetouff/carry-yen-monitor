[Unit]
Description=YCT - regeneration et validation du snapshot Carry Yen
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=yct
Group=yct
EnvironmentFile=/etc/yct/env
Environment=SOURCE_CALENDAR_PATH=/opt/yct/source-calendars.json
Environment=BOJ_POLICY_PATH=/opt/yct/boj-policy.json
ExecStart=/usr/bin/python3 /opt/yct/build_snapshot.py
ExecStartPost=/usr/bin/python3 /opt/yct/verify_snapshot.py /var/lib/yct/data.json --status-path /var/lib/yct/status.json --calendar-path /opt/yct/source-calendars.json --boj-policy-path /opt/yct/boj-policy.json

# --- Durcissement ---
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
RemoveIPC=true
CapabilityBoundingSet=
AmbientCapabilities=
# AF_UNIX requis pour la resolution DNS via systemd-resolved (nss-resolve)
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
SystemCallArchitectures=native
UMask=0027
# seul chemin inscriptible : le repertoire du snapshot
ReadWritePaths=/var/lib/yct
# Le builder s'arrete lui-meme apres 90 s; marge incluse pour la validation finale.
TimeoutStartSec=110
